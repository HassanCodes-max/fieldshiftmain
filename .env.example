# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (Supabase or Neon). Vercel's database integrations set POSTGRES_URL automatically.
# Leave empty in development: a local PGlite database in .data/pglite is used instead.
DATABASE_URL=

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/amis (any long random string).
CRON_SECRET=

# Salt for hashing visitor IP addresses in rate limiting (any long random string).
RATE_LIMIT_SALT=

# Optional: public site URL for metadata/sitemap (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically).
NEXT_PUBLIC_SITE_URL=
